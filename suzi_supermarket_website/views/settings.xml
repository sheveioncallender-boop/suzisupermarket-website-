<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="settings_suzi" model="ir.ui.view">
        <field name="name">res.config.settings.suzi.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Suzi's Supermarket" name="suzi_settings" invisible="not website_id">
                    <setting string="Suzi's website branding" help="Apply the green supermarket design to this website only.">
                        <field name="suzi_branding"/>
                        <div class="mt-2"><button name="action_suzi_setup" type="object" string="Apply initial Suzi's setup" class="btn btn-secondary"/></div>
                    </setting>
                    <setting string="Newsletter mailing list" help="Subscriptions use Odoo Email Marketing; installing the website does not send campaigns.">
                        <field name="suzi_newsletter_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
